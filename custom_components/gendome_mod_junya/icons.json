{
  "entity": {
    "sensor": {
      "battery_soc": {
        "default": "mdi:battery-high",
        "range": {
          "0": "mdi:battery-outline",
          "10": "mdi:battery-10",
          "20": "mdi:battery-20",
          "30": "mdi:battery-30",
          "40": "mdi:battery-40",
          "50": "mdi:battery-50",
          "60": "mdi:battery-60",
          "70": "mdi:battery-70",
          "80": "mdi:battery-80",
          "90": "mdi:battery-90",
          "100": "mdi:battery"
        }
      },
      "remaining_time": {
        "default": "mdi:timer-sand"
      },
      "input_total_power": {
        "default": "mdi:transmission-tower-import"
      },
      "ac_input_power": {
        "default": "mdi:current-ac"
      },
      "solar_input_power": {
        "default": "mdi:solar-power-variant"
      },
      "wind_input_power": {
        "default": "mdi:wind-power"
      },
      "output_total_power": {
        "default": "mdi:home-lightning-bolt"
      },
      "ac_output_power": {
        "default": "mdi:power-plug-outline"
      },
      "dc_output_power": {
        "default": "mdi:current-dc"
      },
      "ac_charge_power_setting": {
        "default": "mdi:tune-vertical"
      },
      "firmware_version": {
        "default": "mdi:chip"
      },
      "wifi_version": {
        "default": "mdi:wifi-cog"
      },
      "mcu_version": {
        "default": "mdi:integrated-circuit-chip"
      },
      "last_update": {
        "default": "mdi:cloud-sync-outline"
      },
      "battery_temperature": {
        "default": "mdi:thermometer"
      },
      "device_temperature": {
        "default": "mdi:home-thermometer-outline"
      },
      "error_code": {
        "default": "mdi:alert-decagram-outline"
      }
    },
    "binary_sensor": {
      "online": {
        "default": "mdi:cloud-off-outline",
        "state": {
          "on": "mdi:cloud-check-outline",
          "off": "mdi:cloud-off-outline"
        }
      },
      "charging": {
        "default": "mdi:battery-charging-outline",
        "state": {
          "on": "mdi:battery-charging",
          "off": "mdi:battery-outline"
        }
      },
      "discharging": {
        "default": "mdi:battery-arrow-down-outline",
        "state": {
          "on": "mdi:battery-arrow-down",
          "off": "mdi:battery-check-outline"
        }
      },
      "ac_input_enabled": {
        "default": "mdi:transmission-tower-off",
        "state": {
          "on": "mdi:transmission-tower-import",
          "off": "mdi:transmission-tower-off"
        }
      },
      "ac_output_enabled": {
        "default": "mdi:power-plug-off-outline",
        "state": {
          "on": "mdi:power-plug",
          "off": "mdi:power-plug-off-outline"
        }
      },
      "dc_output_enabled": {
        "default": "mdi:current-dc",
        "state": {
          "on": "mdi:car-battery",
          "off": "mdi:battery-off-outline"
        }
      },
      "bypass_enabled": {
        "default": "mdi:swap-horizontal-circle-outline",
        "state": {
          "on": "mdi:swap-horizontal-circle",
          "off": "mdi:swap-horizontal-circle-outline"
        }
      },
      "ups_mode": {
        "default": "mdi:shield-off-outline",
        "state": {
          "on": "mdi:shield-lightning",
          "off": "mdi:shield-off-outline"
        }
      },
      "grid_connected": {
        "default": "mdi:transmission-tower-off",
        "state": {
          "on": "mdi:transmission-tower",
          "off": "mdi:transmission-tower-off"
        }
      }
    },
    "switch": {
      "ac_input": {
        "default": "mdi:transmission-tower-off",
        "state": {
          "on": "mdi:transmission-tower-import",
          "off": "mdi:transmission-tower-off"
        }
      },
      "ac_output": {
        "default": "mdi:power-plug-off-outline",
        "state": {
          "on": "mdi:power-plug",
          "off": "mdi:power-plug-off-outline"
        }
      },
      "dc_output": {
        "default": "mdi:current-dc",
        "state": {
          "on": "mdi:car-battery",
          "off": "mdi:battery-off-outline"
        }
      },
      "buzzer": {
        "default": "mdi:volume-off",
        "state": {
          "on": "mdi:volume-high",
          "off": "mdi:volume-off"
        }
      },
      "scheduled_charging": {
        "default": "mdi:calendar-clock-outline",
        "state": {
          "on": "mdi:calendar-clock",
          "off": "mdi:calendar-remove-outline"
        }
      }
    },
    "number": {
      "ac_charge_power_limit": {
        "default": "mdi:lightning-bolt-circle"
      },
      "battery_protection_lower_soc": {
        "default": "mdi:battery-arrow-down-outline"
      },
      "battery_protection_upper_soc": {
        "default": "mdi:battery-arrow-up-outline"
      }
    }
  }
}
